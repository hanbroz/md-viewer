{
  "name": "md-viewer",
  "version": "2026.08.06.022032",
  "description": "Markdown Viewer - View markdown files with syntax highlighting and mermaid diagrams",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:renderer": "node scripts/build.js",
    "build:app": "electron-packager . \"MD Viewer\" --platform=win32 --arch=x64 --icon=mv_icon_minimal.ico --out=release --overwrite --ignore=/release$ --ignore=/release-builds$ --ignore=/_sample$ --ignore=/docs$ --ignore=/scripts$ --ignore=/\\.git$ --ignore=/renderer\\.js$",
    "build:app:mac": "electron-packager . \"MD Viewer\" --platform=darwin --arch=universal --out=release --overwrite --ignore=/release$ --ignore=/release-builds$ --ignore=/_sample$ --ignore=/docs$ --ignore=/scripts$ --ignore=/\\.git$ --ignore=/renderer\\.js$",
    "build": "npm run build:renderer && npm run build:app",
    "build:mac": "npm run build:renderer && npm run build:app:mac",
    "build:installer": "node scripts/build-installer.js",
    "build:portable": "node scripts/build-portable-zip.js",
    "version:stamp": "node scripts/stamp-version.js",
    "dist": "npm run version:stamp && npm run build && npm run build:installer",
    "dist:portable": "npm run version:stamp && npm run build && npm run build:portable"
  },
  "keywords": [
    "markdown",
    "viewer",
    "electron"
  ],
  "author": "Developer",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.27.4",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.5",
    "mermaid": "^11.13.0"
  }
}
