{
  "name": "md-viewer",
  "version": "1.0.0",
  "description": "Markdown Viewer - View markdown files with syntax highlighting and mermaid diagrams",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:renderer": "node scripts/build.js",
    "build:app": "electron-packager . \"MD Viewer\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=/release$ --ignore=/release-builds$ --ignore=/_sample$ --ignore=/docs$ --ignore=/scripts$ --ignore=/\\.git$ --ignore=/renderer\\.js$",
    "build": "npm run build:renderer && npm run build:app"
  },
  "keywords": [
    "markdown",
    "viewer",
    "electron"
  ],
  "author": "Developer",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.27.4",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.5",
    "mermaid": "^11.13.0"
  }
}
